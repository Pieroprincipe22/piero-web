---
// src/components/sections/KodaOrbe.astro
//
// El orbe de Koda, el mismo de la app: una constelación violeta viva.
// Es una copia en JavaScript de app/ui/circle_widget.py del proyecto Koda
// (calidad "alta", estado "reposo"): los mismos nodos repartidos por una
// esfera, las mismas sinapsis que aparecen y desaparecen, el núcleo cálido,
// el canto de cristal y el bloom. Si algún día cambia el orbe de Koda, se
// copian aquí los mismos valores.
//
// - Si el ratón pasa por encima, el orbe se gira hacia él y los nodos
//   cercanos se encienden, como en Koda.
// - Con «reducir movimiento» activado en el sistema, se pinta quieto.
// - Cuando no se ve en pantalla, deja de dibujarse para no gastar batería.
//
// Uso: <KodaOrbe lado={440} etiqueta="..." />
interface Props {
  /** Tamaño en píxeles (lado del cuadrado). */
  lado?: number;
  /** Texto para lectores de pantalla. */
  etiqueta?: string;
}
const { lado = 320, etiqueta = 'El orbe de Koda' } = Astro.props;
---

<canvas
  class="koda-orbe"
  data-koda-orbe
  width={lado}
  height={lado}
  style={`width:${lado}px`}
  role="img"
  aria-label={etiqueta}
></canvas>

<style>
  .koda-orbe { display: block; max-width: 100%; height: auto; aspect-ratio: 1; }
</style>

<script>
  // Los mismos valores que circle_widget.py (calidad "alta", estado "reposo").
  const COLOR = [167, 139, 250]; // theme.ACCENT, #A78BFA
  const BRILLO = 0.62;
  const BLOOM = 0.55;
  const NODOS = 120;
  const NUCLEO_RADIO = 0.3;
  const ESFERA_BORDE = 0.86;
  const RADIO_RATON = 95;
  const SINAPSIS_BASE = 0.46;
  const DERIVA = 0.16;
  const DERIVA_VEL = 0.35;
  const PERSPECTIVA = 2.7;
  const GIRO_BASE = 0.0032;
  const SUAVIZADO = 0.08;
  const CADA_CUMBRE = 7;
  const RESP = [0.02, 5.0]; // respiración: amplitud y periodo (s)

  const rgba = (a: number) => `rgba(${COLOR[0]},${COLOR[1]},${COLOR[2]},${Math.max(0, Math.min(1, a))})`;

  function iniciar(canvas: HTMLCanvasElement) {
    const lado = canvas.width;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = lado * dpr;
    canvas.height = lado * dpr;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Capa donde se dibuja todo, y capa pequeña para el desenfoque (bloom).
    const capa = document.createElement('canvas');
    capa.width = canvas.width;
    capa.height = canvas.height;
    const q = capa.getContext('2d')!;
    // El navegador, al reducir de golpe a 1/5, se salta píxeles y las líneas
    // finas desaparecen del desenfoque. Qt promedia. Para parecerse, se reduce
    // en pasos: 1/2, 1/4 y 1/5.
    const pasos = [2, 4, 5].map((f) => {
      const c = document.createElement('canvas');
      c.width = c.height = Math.max(1, Math.floor(canvas.width / f));
      return c;
    });
    const chica = pasos[pasos.length - 1];

    // Puntos de Fibonacci: repartidos parejo por la esfera.
    const n = NODOS;
    const base: number[][] = [];
    const t1: number[][] = [];
    const t2: number[][] = [];
    const w1: number[] = [], w2: number[] = [], p1: number[] = [], p2: number[] = [];
    const wt: number[] = [], pt: number[] = [], cumbre: boolean[] = [];
    for (let i = 0; i < n; i++) {
      const y = 1 - (2 * i) / (n - 1);
      const r = Math.sqrt(Math.max(0, 1 - y * y));
      const phi = i * Math.PI * (3 - Math.sqrt(5));
      const b = [Math.cos(phi) * r, y, Math.sin(phi) * r];
      base.push(b);
      // Dos direcciones tangentes para que cada nodo derive sobre la esfera.
      let a = [-b[2], 0, b[0]]; // b × (0, 1, 0)
      let na = Math.hypot(a[0], a[1], a[2]);
      if (na < 1e-6) { a = [0, b[2], -b[1]]; na = Math.hypot(a[0], a[1], a[2]); }
      a = a.map((v) => v / Math.max(na, 1e-9));
      t1.push(a);
      t2.push([b[1] * a[2] - b[2] * a[1], b[2] * a[0] - b[0] * a[2], b[0] * a[1] - b[1] * a[0]]);
      w1.push(0.6 + (0.35 * ((i * 7) % 5)) / 4);
      w2.push(0.5 + (0.4 * ((i * 11) % 7)) / 6);
      p1.push((i * 1.7) % (2 * Math.PI));
      p2.push((i * 2.9) % (2 * Math.PI));
      wt.push(1.1 + (0.9 * ((i * 13) % 6)) / 5);
      pt.push((i * 0.9) % (2 * Math.PI));
      cumbre.push(i % CADA_CUMBRE === 0);
    }
    const dist2 = (SINAPSIS_BASE * Math.sqrt(120 / n)) ** 2;

    // Halos pre-dibujados, como sprite_halo().
    const sprites = new Map<string, HTMLCanvasElement>();
    function halo(d: number, fuerza: number) {
      d = Math.max(4, Math.floor(d / 2) * 2);
      const k = `${d}|${fuerza}`;
      let s = sprites.get(k);
      if (!s) {
        s = document.createElement('canvas');
        s.width = s.height = d;
        const c = s.getContext('2d')!;
        const g = c.createRadialGradient(d / 2, d / 2, 0, d / 2, d / 2, d / 2);
        const a = BRILLO * fuerza;
        g.addColorStop(0, rgba(a));
        g.addColorStop(0.3, rgba((90 / 255) * a));
        g.addColorStop(1, rgba(0));
        c.fillStyle = g;
        c.beginPath(); c.arc(d / 2, d / 2, d / 2, 0, Math.PI * 2); c.fill();
        sprites.set(k, s);
      }
      return s;
    }

    let fase = 0, ang = 0, desv = 0, desvObj = 0, incl = 0, inclObj = 0, cerca = 0;
    let raton: [number, number] | null = null;

    canvas.addEventListener('pointermove', (e) => {
      const rect = canvas.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * lado;
      const y = ((e.clientY - rect.top) / rect.height) * lado;
      const c = lado / 2;
      raton = [x, y];
      desvObj = Math.max(-1, Math.min(1, (x - c) / c)) * 0.45;
      inclObj = Math.max(-1, Math.min(1, (y - c) / c)) * 0.35;
    });
    canvas.addEventListener('pointerleave', () => { raton = null; desvObj = inclObj = 0; });

    function dibujar(g: CanvasRenderingContext2D) {
      const c = lado / 2;
      // --- proyección ---
      const t = fase * DERIVA_VEL;
      const px = new Float64Array(n), py = new Float64Array(n), pz = new Float64Array(n), prof = new Float64Array(n);
      const pts: number[][] = [];
      const a = ang + desv, ca = Math.cos(a), sa = Math.sin(a), ci = Math.cos(incl), si = Math.sin(incl);
      const latido = Math.sin((fase * 2 * Math.PI) / RESP[1]) * RESP[0];
      const radio = lado * 0.278 * (1 + latido);
      for (let i = 0; i < n; i++) {
        const d1 = Math.sin(t * w1[i] + p1[i]) * DERIVA;
        const d2 = Math.sin(t * w2[i] + p2[i]) * DERIVA;
        let v = [0, 1, 2].map((k) => base[i][k] + t1[i][k] * d1 + t2[i][k] * d2);
        const nv = Math.max(Math.hypot(v[0], v[1], v[2]), 1e-9);
        v = v.map((x) => x / nv);
        const x = v[0] * ca + v[2] * sa;
        const z1 = -v[0] * sa + v[2] * ca;
        const y = v[1] * ci - z1 * si;
        const z = v[1] * si + z1 * ci;
        const pr = 1 / (PERSPECTIVA - z);
        px[i] = c + x * radio * pr * PERSPECTIVA;
        py[i] = c + y * radio * pr * PERSPECTIVA;
        pz[i] = z; prof[i] = pr; pts.push([x, y, z]);
      }
      // --- el ratón enciende los nodos cercanos ---
      const infl = new Float64Array(n);
      if (raton && cerca > 0.01) {
        for (let i = 0; i < n; i++) {
          const dr = Math.hypot(px[i] - raton[0], py[i] - raton[1]);
          infl[i] = Math.max(0, Math.min(1, 1 - dr / RADIO_RATON)) ** 2 * cerca;
        }
      }
      // --- 1. aura ---
      g.globalCompositeOperation = 'source-over';
      const brillo = 0.55 * BRILLO;
      const ga = g.createRadialGradient(c, c, 0, c, c, radio * 1.9);
      ga.addColorStop(0, rgba((70 / 255) * brillo));
      ga.addColorStop(0.5, rgba((26 / 255) * brillo));
      ga.addColorStop(1, rgba(0));
      g.fillStyle = ga;
      g.beginPath(); g.arc(c, c, radio * 1.9, 0, Math.PI * 2); g.fill();

      g.globalCompositeOperation = 'lighter';
      // --- sinapsis ---
      const lineas: [number, number, number, boolean][] = [];
      for (let i = 0; i < n; i++) {
        for (let j = i + 1; j < n; j++) {
          const dx = pts[i][0] - pts[j][0], dy = pts[i][1] - pts[j][1], dz = pts[i][2] - pts[j][2];
          const d = dx * dx + dy * dy + dz * dz;
          if (d >= dist2) continue;
          const fuerza = Math.max(0, Math.min(1, 1 - Math.sqrt(d / dist2)));
          const frente = Math.max(0, Math.min(1, (pz[i] + pz[j] + 2) / 4));
          const toque = Math.max(infl[i], infl[j]);
          const alfa = (14 + 95 * fuerza * frente * 0.7) * BRILLO * (1 + 1.6 * toque);
          lineas.push([i, j, alfa, (pz[i] + pz[j]) / 2 < 0]);
        }
      }
      // Como en Koda: las sinapsis se pintan por lotes, en cuatro cubos de opacidad.
      const CUBOS = [[0, 28], [28, 58], [58, 110], [110, 400]];
      function trazar(detras: boolean) {
        g.lineWidth = 1;
        for (const [lo, hi] of CUBOS) {
          g.strokeStyle = rgba(Math.min(210, (lo + hi) / 2) / 255);
          g.beginPath();
          let alguna = false;
          for (const [i, j, alfa, d] of lineas) {
            if (d !== detras || alfa < lo || alfa >= hi) continue;
            g.moveTo(px[i], py[i]); g.lineTo(px[j], py[j]);
            alguna = true;
          }
          if (alguna) g.stroke();
        }
      }
      function nodos(detras: boolean) {
        const orden = Array.from({ length: n }, (_, i) => i).sort((x, y) => pz[x] - pz[y]);
        for (const i of orden) {
          if ((pz[i] < 0) !== detras) continue;
          const tw = 0.78 + 0.22 * Math.sin(fase * wt[i] + pt[i]);
          const cer = Math.max(0, Math.min(1, (pz[i] + 1) / 2));
          const rp = Math.hypot(px[i] - c, py[i] - c) / Math.max(1, radio);
          const borde = Math.max(0, Math.min(1, (rp - 0.55) / 0.45));
          let alfa = (0.25 + 0.75 * cer) * (0.85 + 0.35 * borde) * tw * 0.75 * (1 + 1.3 * infl[i]);
          alfa = Math.min(1, alfa);
          const crece = 1 + 0.55 * infl[i];
          const d = Math.floor(((cumbre[i] ? 8 : 5) + (cumbre[i] ? 30 : 20) * prof[i]) * crece);
          const s = halo(d, cumbre[i] ? 1.25 : 0.9);
          g.globalAlpha = alfa;
          g.drawImage(s, px[i] - s.width / 2, py[i] - s.height / 2);
        }
        g.globalAlpha = 1;
      }
      trazar(true);
      nodos(true);
      // --- 2. núcleo ---
      const rn = radio * NUCLEO_RADIO;
      const gn = g.createRadialGradient(c, c, 0, c, c, rn);
      gn.addColorStop(0, `rgba(255,255,255,${(205 / 255) * BRILLO})`);
      gn.addColorStop(0.32, rgba((185 / 255) * BRILLO));
      gn.addColorStop(1, rgba(0));
      g.fillStyle = gn;
      g.beginPath(); g.arc(c, c, rn, 0, Math.PI * 2); g.fill();
      // --- 3. cristal: solo el canto ---
      const ge = g.createRadialGradient(c, c, 0, c, c, radio);
      ge.addColorStop(0, rgba(0));
      ge.addColorStop(0.58, rgba(0));
      ge.addColorStop(ESFERA_BORDE, rgba((14 / 255) * BRILLO));
      ge.addColorStop(0.985, rgba((78 / 255) * BRILLO));
      ge.addColorStop(1, rgba(0));
      g.fillStyle = ge;
      g.beginPath(); g.arc(c, c, radio, 0, Math.PI * 2); g.fill();
      // --- 4. lo de delante ---
      trazar(false);
      nodos(false);
      g.globalCompositeOperation = 'source-over';
    }

    function fotograma() {
      q.setTransform(1, 0, 0, 1, 0, 0);
      q.clearRect(0, 0, capa.width, capa.height);
      q.setTransform(dpr, 0, 0, dpr, 0, 0);
      dibujar(q);
      ctx!.clearRect(0, 0, canvas.width, canvas.height);
      ctx!.globalCompositeOperation = 'source-over';
      ctx!.drawImage(capa, 0, 0);
      // Bloom: reducir y volver a ampliar es un desenfoque barato.
      let origen: HTMLCanvasElement = capa;
      for (const paso of pasos) {
        const qp = paso.getContext('2d')!;
        qp.imageSmoothingQuality = 'high';
        qp.clearRect(0, 0, paso.width, paso.height);
        qp.drawImage(origen, 0, 0, paso.width, paso.height);
        origen = paso;
      }
      ctx!.globalCompositeOperation = 'lighter';
      ctx!.globalAlpha = BLOOM;
      ctx!.imageSmoothingQuality = 'high';
      ctx!.drawImage(chica, 0, 0, canvas.width, canvas.height);
      ctx!.globalAlpha = 1;
      ctx!.globalCompositeOperation = 'source-over';
    }

    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let visible = true;
    let ultimo = performance.now();
    function bucle(ahora: number) {
      const ms = Math.max(0, Math.min(50, ahora - ultimo));
      ultimo = ahora;
      if (visible) {
        // Koda avanza cada 16 ms. Aquí cada fotograma dura lo que diga la
        // pantalla (60, 120 o 144 por segundo): se ajusta para que el orbe
        // vaya igual de rápido en todas.
        const k = ms / 16;
        const suave = (f: number) => 1 - Math.pow(1 - f, k);
        fase += ms / 1000;
        ang += GIRO_BASE * k;
        desv += (desvObj - desv) * suave(SUAVIZADO);
        incl += (inclObj - incl) * suave(SUAVIZADO);
        cerca += ((raton ? 1 : 0) - cerca) * suave(0.12);
        fotograma();
      }
      requestAnimationFrame(bucle);
    }
    if (quieto) {
      fase = 3;
      fotograma();
    } else {
      new IntersectionObserver((e) => { visible = e[0].isIntersecting; }).observe(canvas);
      requestAnimationFrame(bucle);
    }
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-koda-orbe]').forEach(iniciar);
</script>